{
  "case": "mixed/full_stack",
  "notes": "Crew agent plus MCP server plus IaC grant: each layer observed independently; no declared cloud surface exists so the grant stays UNKNOWN.",
  "agents": [{"framework": "crewai", "name": "Agent"}],
  "tools": [
    {"tool_key": "mcp_server:docs",
     "capabilities": [
       {"name": "mcp", "access_mode": "read"},
       {"name": "mcp_tool:search_docs", "access_mode": "read"},
       {"name": "shell", "access_mode": "execute"}
     ]},
    {"tool_key": "unknown:unattributed",
     "capabilities": [{"name": "mcp", "access_mode": "read"}]}
  ],
  "identities": [{"kind": "aws_iam_role", "name": "support-role", "namespace": ""}],
  "grants": [
    {"identity": "support-role", "actions": ["s3:GetObject"],
     "resources": ["arn:aws:s3:::support-docs/*"], "resolution": "resolved"}
  ],
  "verdicts": {"aws:s3": "UNKNOWN"},
  "must_fire": ["MCP_AUTH_MISSING"],
  "must_not_fire": [],
  "evidence_refs": ["crew.py", ".mcp.json", "main.tf"],
  "uncertainty": [{"kind": "unlinked", "match": "aws:s3"}]
}

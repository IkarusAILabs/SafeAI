{
  "case": "adversarial/role_name_prefix",
  "notes": "agent-role-prod's admin grant coexists unlinked; it must never attribute to the agent or convert the verdict.",
  "agents": [{"framework": "langchain", "name": "initialize_agent"}],
  "tools": [
    {"tool_key": "mcp_server:storage",
     "capabilities": [
       {"name": "cloud", "access_mode": "read"},
       {"name": "mcp", "access_mode": "read"},
       {"name": "mcp_tool:s3_list_buckets", "access_mode": "read"},
       {"name": "shell", "access_mode": "execute"}
     ]},
    {"tool_key": "unknown:unattributed",
     "capabilities": [
       {"name": "multi_agent_or_delegation", "access_mode": "read"},
       {"name": "planner_chain", "access_mode": "read"}
     ]}
  ],
  "identities": [
    {"kind": "aws_iam_role", "name": "agent-role", "namespace": ""},
    {"kind": "aws_iam_role", "name": "agent-role-prod", "namespace": ""}
  ],
  "grants": [
    {"identity": "agent-role", "actions": ["s3:GetObject"],
     "resources": ["arn:aws:s3:::agent-bucket/*"], "resolution": "resolved"},
    {"identity": "agent-role-prod", "actions": ["s3:*"],
     "resources": ["*"], "resolution": "resolved"}
  ],
  "links": [],
  "verdicts": {"aws:s3": "UNVERIFIED_LINK"},
  "must_fire": ["CAP_s3", "IAC_UNVERIFIED_LINK"],
  "must_not_fire": ["IAC_EXCESS_AUTHORITY"],
  "evidence_refs": ["agent.py", "main.tf", ".mcp.json"],
  "uncertainty": [
    {"kind": "inferred", "match": "multi_agent_or_delegation"},
    {"kind": "unlinked", "match": "aws:s3"}
  ]
}

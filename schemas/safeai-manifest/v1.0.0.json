{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ikaruscareer/SafeAI/schemas/safeai-manifest/v1.0.0.json",
  "title": "SafeAI KYA Manifest Contract v1.0.0",
  "description": "Portable, offline, static-analysis KYA evidence document (safeai-manifest.json). Only fields genuinely emitted by safeai/kya/manifest.py build_manifest() are required; everything else is optional. Unknown optional fields MUST be ignored by 1.x readers.",
  "type": "object",
  "required": ["schema_version", "manifest_type", "safeai", "project", "agents", "findings", "summary", "assurance_boundary", "limitations"],
  "properties": {
    "schema_version": {
      "description": "Legacy document version string. Contract v1.0.0 accepts 1.0, 1.1, 1.2 (additive).",
      "type": "string",
      "enum": ["1.0", "1.1", "1.2"]
    },
    "contract": {
      "description": "Machine-readable contract identity, distinct from package version. Optional on pre-2.2 manifests.",
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "safeai-manifest"},
        "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "compatibility": {
          "type": "object",
          "properties": {
            "minimum_reader_version": {"type": "string"}
          }
        }
      }
    },
    "manifest_type": {"const": "safeai.kya"},
    "generated_at": {"type": ["string", "null"]},
    "safeai": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {"type": "string"},
        "ruleset_version": {"type": ["string", "null"]},
        "config_hash": {"type": ["string", "null"]},
        "custom_rules_dir": {"type": ["string", "null"]},
        "custom_rules_count": {"type": "integer"},
        "builtin_rules_count": {"type": "integer"},
        "rule_pack_ids": {"type": "array", "items": {"type": "string"}},
        "analyzer_versions": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
        "parser_versions": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
        "policy_profile": {"type": ["string", "null"]}
      }
    },
    "project": {
      "type": "object",
      "required": ["project_id"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "name": {"type": ["string", "null"]},
        "source_root": {"type": ["string", "null"]},
        "repository": {"type": "object"}
      }
    },
    "scan": {
      "type": "object",
      "properties": {
        "scan_id": {"type": ["string", "null"]},
        "started_at": {"type": ["string", "null"]},
        "completed_at": {"type": ["string", "null"]},
        "files_scanned": {"type": "integer"},
        "analysis_coverage": {"type": "object"}
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent_id"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "name": {"type": ["string", "null"]},
          "framework": {"type": "string"}
        }
      }
    },
    "tool_surface": {"type": "array"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "name": {"type": ["string", "null"]},
          "path": {"type": ["string", "null"]},
          "content_hash": {"type": ["string", "null"]}
        }
      }
    },
    "dependency_inventory": {"type": "array"},
    "findings": {      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity"],
        "properties": {
          "finding_id": {"type": ["string", "null"]},
          "rule_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "title": {"type": ["string", "null"]},
          "message": {"type": "string"},
          "remediation": {"type": ["string", "null"]},
          "confidence": {"type": ["string", "null"]},
          "provenance": {"type": "object"},
          "provenance_class": {"enum": ["declared", "detected", "inferred", "unknown", "repo-iac-observed"]},
          "gateability": {"enum": ["deterministic", "review-only"]},
          "location": {"type": "object"},
          "fingerprint": {"type": ["string", "null"]},
          "status": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["policy_decision"],
      "properties": {
        "risk_score": {"type": ["number", "null"]},
        "severity_counts": {"type": "object"},
        "capability_counts": {"type": "object"},
        "agent_count": {"type": "integer"},
        "component_count": {"type": "integer"},
        "dependency_count": {"type": "integer"},
        "authority_change_counts": {"type": "object"},
        "highest_change_class": {"enum": ["NO_CHANGE", "LOW_CHANGE", "MATERIAL_CHANGE", "HIGH_RISK_CHANGE", "UNKNOWN"]},
        "policy_decision": {
          "type": "object",
          "required": ["outcome"],
          "properties": {
            "outcome": {"enum": ["pass", "warn", "review-required", "block", "accepted-exception"]}
          }
        }
      }
    },
    "assurance_boundary": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "escalations": {
      "description": "Flattened capability-diff escalations with structured remediation (absent when no baseline).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity"],
        "properties": {
          "tool_key": {"type": ["string", "null"]},
          "id": {"type": "string"},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "summary": {"type": ["string", "null"]},
          "before": {"type": ["string", "null"]},
          "after": {"type": ["string", "null"]},
          "confidence": {"type": ["string", "null"]},
          "remediation": {"type": "object"}
        }
      }
    },
    "authority_changes": {
      "description": "Compact per-tool authority changes (v2.4 portable change evidence).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool_key", "change_class"],
        "properties": {
          "tool_key": {"type": "string"},
          "status": {"type": ["string", "null"]},
          "change_class": {"enum": ["NO_CHANGE", "LOW_CHANGE", "MATERIAL_CHANGE", "HIGH_RISK_CHANGE", "UNKNOWN"]},
          "change_types": {"type": "array", "items": {"type": "string"}},
          "inferred_only": {"type": "boolean"}
        }
      }
    },
    "exception_evaluations": {
      "description": "Policy exception evaluation records (v2.4 exception evidence).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exception_id", "state"],
        "properties": {
          "exception_id": {"type": "string"},
          "target_type": {"type": "string"},
          "target_id": {"type": ["string", "null"]},
          "state": {"enum": ["active", "expired", "stale", "scope-mismatch", "invalid"]},
          "risk_owner": {"type": ["string", "null"]},
          "expires_at": {"type": ["string", "null"]}
        }
      }
    },
    "iac_correlations": {
      "description": "IaC authority correlation evidence (v2.5, Lane B review-only; schema_version 2 authority graph).",
      "type": "object",
      "properties": {
        "schema_version": {"type": "integer"},
        "correlation_model": {"type": "string"},
        "lane": {"const": "B"},
        "counts": {"type": "object"},
        "files": {"type": "object"},
        "identities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name"],
            "properties": {
              "kind": {"type": "string"},
              "name": {"type": "string"},
              "namespace": {"type": "string"},
              "source_ref": {"type": "string"}
            }
          }
        },
        "agent_identity_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent", "identity", "link_type"],
            "properties": {
              "agent": {"type": "string"},
              "identity": {"type": "object"},
              "link_type": {"type": "string"},
              "confidence": {"type": "string"},
              "evidence": {"type": "array"}
            }
          }
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_file"],
            "properties": {
              "identity": {"type": "object"},
              "actions": {"type": "object"},
              "resources": {"type": "object"},
              "scope": {"type": "string"},
              "source": {"type": "string"},
              "source_file": {"type": "string"},
              "line": {"type": "integer"},
              "provenance": {"type": "string"},
              "fidelity": {"type": "array", "items": {"type": "string"}},
              "family": {"type": "string"}
            }
          }
        },
        "grant_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "identity": {"type": "object"},
              "binding_kind": {"type": "string"},
              "binding_name": {"type": "string"},
              "role": {"type": "string"},
              "source_file": {"type": "string"},
              "line": {"type": "integer"}
            }
          }
        },
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["verdict"],
            "properties": {
              "agent_ref": {"type": "string"},
              "identity_ref": {"type": ["object", "null"]},
              "domain": {"type": "string"},
              "family": {"type": "string"},
              "verdict": {"enum": ["MATCH", "EXCESS_AUTHORITY", "AUTHORITY_MISMATCH", "UNVERIFIED_LINK", "UNKNOWN"]},
              "declared_evidence_refs": {"type": "array", "items": {"type": "string"}},
              "grant_evidence_refs": {"type": "array", "items": {"type": "string"}},
              "link_evidence_refs": {"type": "array", "items": {"type": "string"}},
              "resolution": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "authority_evidence": {
      "description": "Agent Authority Evidence Contract v1 (additive extension to the KYA Manifest Contract). Represents statically evidenced, potentially reachable agent authority with provenance, uncertainty, and assurance boundaries. Independent tooling can consume this without SafeAI internals.",
      "type": "object",
      "properties": {
        "contract_identity": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "subject_agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent_id", "framework"],
            "properties": {
              "agent_id": {"type": "string", "minLength": 1},
              "framework": {"type": "string"}
            }
          }
        },
        "principal_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["principal_id", "kind"],
            "properties": {
              "principal_id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["aws_iam_role", "kubernetes_service_account", "kubernetes_user", "kubernetes_group", "unknown"]},
              "provenance": {"enum": ["declared", "detected", "inferred", "unknown", "repo-iac-observed"]},
              "source_ref": {"type": "string"},
              "namespace": {"type": "string"}
            }
          }
        },
        "delegation_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_agent", "target_agent", "delegation_type"],
            "properties": {
              "source_agent": {"type": "string"},
              "target_agent": {"type": "string"},
              "delegation_type": {"enum": ["explicit_sub_agent", "framework_delegation", "workflow_delegation", "mcp_delegation", "unknown"]},
              "provenance": {"enum": ["declared", "detected", "inferred", "unknown", "repo-iac-observed"]},
              "resolvability": {"enum": ["resolved", "unresolved", "unknown"]},
              "evidence_refs": {"type": "array", "items": {"type": "string"}},
              "confidence": {"type": "string"},
              "notes": {"type": "string"}
            }
          }
        },
        "authority_statements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement_id", "agent_id", "capability", "provenance"],
            "properties": {
              "statement_id": {"type": "string", "minLength": 1},
              "agent_id": {"type": "string", "minLength": 1},
              "principal_ref": {"type": ["string", "null"]},
              "tool_ref": {"type": ["string", "null"]},
              "capability": {"type": "string"},
              "access_mode": {"enum": ["none", "read", "write", "mutate", "execute", "unknown"]},
              "resource_provider": {"enum": ["aws", "kubernetes", "gcp", "azure", "filesystem", "shell", "network", "database", "mcp", "unknown"]},
              "resource": {"type": "string"},
              "destination": {"type": "string"},
              "provenance": {"enum": ["declared", "detected", "inferred", "unknown", "repo-iac-observed"]},
              "confidence": {"type": "string"},
              "resolution": {"enum": ["resolved", "unresolved", "contradicted", "unknown"]},
              "evidence_refs": {"type": "array", "items": {"type": "string"}},
              "assurance_boundary": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "evidence_references": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "uncertainty_summary": {
          "type": "object",
          "properties": {
            "authority_statement_count": {"type": "integer"},
            "resolved_count": {"type": "integer"},
            "unresolved_count": {"type": "integer"},
            "unknown_count": {"type": "integer"},
            "inferred_count": {"type": "integer"},
            "evidence_backed_count": {"type": "integer"}
          }
        },
        "assurance_boundary": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_revision": {
          "type": "object",
          "properties": {
            "commit": {"type": "string"},
            "repository": {"type": "string"}
          }
        },
        "safeai_version": {"type": "string"},
        "ruleset_version": {"type": "string"},
        "change_context": {
          "type": "object",
          "properties": {
            "baseline_ref": {"type": "string"},
            "current_revision": {"type": "string"},
            "change_class": {"enum": ["NO_CHANGE", "LOW_CHANGE", "MATERIAL_CHANGE", "HIGH_RISK_CHANGE", "UNKNOWN"]}
          }
        }
      },
      "additionalProperties": true
    },
    "integrity": {
      "description": "Offline integrity block (added in contract v1.0.0, Workstream 2). Absent on pre-2.2 manifests.",
      "type": "object",
      "required": ["algorithm", "canonicalization", "payload_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "safeai-manifest-v1"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified": {"type": "boolean"}
      }
    }
  }
}
